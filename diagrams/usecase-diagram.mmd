%% SEVIMA-Mini Use Case Diagram (Minggu 2 - Refinement & Skenario)
%% Aktor: Calon Mahasiswa, Mahasiswa, Dosen Pengampu, Dosen PA, Admin Akademik, Sistem PMB, Layanan Pembayaran Bank
%% Relasi: Association (---), <<include>> (wajib: base --> included), <<extend>> (opsional: extension --> base)
flowchart LR
    %% ==========================================
    %% AKTOR EKSTERNAL (Di luar System Boundary)
    %% ==========================================
    CalonMahasiswa(["[Aktor] Calon Mahasiswa"])
    Mahasiswa(["[Aktor] Mahasiswa"])
    DosenPengampu(["[Aktor] Dosen Pengampu"])
    DosenPA(["[Aktor] Dosen PA"])
    Admin(["[Aktor] Admin Akademik"])
    SistemPMB(["[Sistem] Sistem PMB"])
    BankGateway(["[Sistem] Layanan Pembayaran Bank"])

    %% ==========================================
    %% SYSTEM BOUNDARY: SEVIMA-Mini
    %% ==========================================
    subgraph SEVIMA_Mini ["System Boundary: SEVIMA-Mini"]
        direction TB

        %% Modul PMB
        UC_Daftar(["Daftar Calon Mahasiswa"])
        UC_Unggah(["Unggah Berkas PMB"])
        UC_Verif(["Verifikasi Berkas PMB"])
        UC_NIM(["Terbitkan NIM & Akun"])

        %% Modul KRS
        UC_IsiKRS(["Isi KRS"])
        UC_CekPrasyarat(["Cek Prasyarat Mata Kuliah"])
        UC_CekSKS(["Cek Batas Maks 24 SKS"])
        UC_CekBentrok(["Cek Jadwal Bentrok"])
        UC_ApproveKRS(["Approve KRS"])
        UC_RevisiKRS(["Ajukan Revisi KRS"])

        %% Modul Akademik, Nilai & Presensi
        UC_InputNilai(["Input Nilai"])
        UC_Transkrip(["Generate Transkrip"])
        UC_KelolaJadwal(["Kelola Mata Kuliah & Jadwal"])
        UC_Presensi(["Catat Presensi QR"])

        %% Modul Keuangan / SPP
        UC_BayarSPP(["Bayar SPP"])
        UC_BayarDenda(["Bayar Denda Keterlambatan"])
    end

    %% ==========================================
    %% ASOSIASI AKTOR -> USE CASE
    %% ==========================================
    CalonMahasiswa --- UC_Daftar
    SistemPMB --- UC_Daftar
    SistemPMB --- UC_Verif
    Admin --- UC_Verif
    Admin --- UC_KelolaJadwal

    Mahasiswa --- UC_IsiKRS
    Mahasiswa --- UC_RevisiKRS
    Mahasiswa --- UC_Transkrip
    Mahasiswa --- UC_Presensi
    Mahasiswa --- UC_BayarSPP

    DosenPA --- UC_ApproveKRS
    DosenPengampu --- UC_InputNilai
    DosenPengampu --- UC_Presensi

    BankGateway --- UC_BayarSPP

    %% ==========================================
    %% RELASI <<include>> (Langkah Wajib: Base --> Included)
    %% ==========================================
    UC_Daftar -. "«include»" .-> UC_Unggah
    UC_IsiKRS -. "«include»" .-> UC_CekPrasyarat
    UC_IsiKRS -. "«include»" .-> UC_CekSKS
    UC_IsiKRS -. "«include»" .-> UC_CekBentrok

    %% ==========================================
    %% RELASI <<extend>> (Opsional/Kondisional: Extension --> Base)
    %% ==========================================
    UC_NIM -. "«extend»<br/>[jika lulus seleksi]" .-> UC_Verif
    UC_RevisiKRS -. "«extend»<br/>[jika ditolak Dosen PA]" .-> UC_ApproveKRS
    UC_BayarDenda -. "«extend»<br/>[jika lewat jatuh tempo]" .-> UC_BayarSPP

    %% Styling
    classDef actor fill:#f1f5f9,stroke:#334155,stroke-width:2px,color:#0f172a,font-weight:bold
    classDef usecase fill:#eff6ff,stroke:#2563eb,stroke-width:1.5px,color:#1e3a8a
    classDef subuc fill:#f0fdf4,stroke:#16a34a,stroke-width:1.5px,color:#14532d
    classDef extuc fill:#fff7ed,stroke:#ea580c,stroke-width:1.5px,color:#7c2d12

    class CalonMahasiswa,Mahasiswa,DosenPengampu,DosenPA,Admin,SistemPMB,BankGateway actor
    class UC_Daftar,UC_Verif,UC_IsiKRS,UC_ApproveKRS,UC_InputNilai,UC_Transkrip,UC_KelolaJadwal,UC_Presensi,UC_BayarSPP usecase
    class UC_Unggah,UC_CekPrasyarat,UC_CekSKS,UC_CekBentrok subuc
    class UC_NIM,UC_RevisiKRS,UC_BayarDenda extuc
