%% SEVIMA-Mini Class Diagram (Minggu 2 Final - Synced, SOLID, Factory, Observer, Strategy)
%% Sinkron 100% dengan: usecase-diagram.mmd, sequence-pmb.mmd, dan sequence-krs.mmd
%% Memenuhi: 5 Pilar OOP, SOLID (SRP, OCP, LSP, ISP, DIP), Factory, Observer, Strategy, Anti-God Object, Anti-Circular Dependency
classDiagram
    %% ==========================================
    %% 1. INTERFACE SEGREGATION (ISP)
    %% ==========================================
    class IPengisiKRS {
        <<interface>>
        +isiKRS(List~Course~ daftarCourse) void
    }

    class IPenyetujuKRS {
        <<interface>>
        +approveKRS(Enrollment enrollment) void
        +tolakKRS(Enrollment enrollment, String alasan) void
    }

    class IPenilai {
        <<interface>>
        +inputNilai(Enrollment enrollment, float angka) Grade
    }

    %% ==========================================
    %% 2. HIERARKI USER (Abstraction, Inheritance, LSP)
    %% ==========================================
    class User {
        <<abstract>>
        #int id
        #String nama
        #String email
        #String username
        -String password
        +login(String username, String password) bool
        +logout() void
        +getNama() String
        +getEmail() String
        +tampilkanDashboard()* void
    }

    class Mahasiswa {
        -String nim
        -int semester
        -float ipk
        -String statusAktif
        -int calonMahasiswaId
        +getNIM() String
        +getIPK() float
        +updateIPK(float ipkBaru) void
        +isiKRS(List~Course~ daftarCourse) void
        +lihatTranskrip() String
        +scanQRPresensi(String kodeQR) Attendance
        +tampilkanDashboard() void
    }

    class Dosen {
        -String nidn
        -String bidangKeahlian
        +getNIDN() String
        +inputNilai(Enrollment enrollment, float angka) Grade
        +approveKRS(Enrollment enrollment) void
        +tolakKRS(Enrollment enrollment, String alasan) void
        +buatQRPresensi(Schedule schedule) String
        +tampilkanDashboard() void
    }

    class Admin {
        -String nip
        -String departemen
        +kelolaMataKuliah(Course course) void
        +kelolaJadwal(Schedule schedule) void
        +tampilkanDashboard() void
    }

    class CalonMahasiswa {
        -String noDaftar
        -String statusSeleksi
        -String berkasPath
        +getNoDaftar() String
        +unggahBerkas(String filePath) void
        +cekStatusSeleksi() String
        +tampilkanDashboard() void
    }

    %% ==========================================
    %% 3. ENTITAS DOMAIN INTI & ORGANISASI
    %% ==========================================
    class ProgramStudi {
        -String kodeProdi
        -String namaProdi
        +tambahDosen(Dosen dosen) void
        +daftarDosen() List~Dosen~
    }

    class Course {
        -String kode
        -String nama
        -int sks
        -int semesterRekomendasi
        +getKode() String
        +getSKS() int
        +getPrasyarat() List~Course~
        +tambahPrasyarat(Course prasyarat) void
    }

    class Enrollment {
        -int id
        -String semester
        -String tahunAkademik
        -String status
        +setStatus(String status) void
        +getStatus() String
    }

    class Schedule {
        -int id
        -String hari
        -String jamMulai
        -String jamSelesai
        -String ruangan
        +isBentrokDengan(Schedule other) bool
        +getInfoJadwal() String
    }

    class Grade {
        -float nilaiAngka
        -String nilaiHuruf
        -float bobot
        +konversiHuruf() String
        +getBobot() float
    }

    class Payment {
        -int id
        -String semester
        -double jumlah
        -Date tanggalBayar
        -String status
        +bayar(double nominal) bool
        +isLunas() bool
    }

    class Attendance {
        -int id
        -DateTime waktuScan
        -String kodeQR
        -String statusHadir
        +catatKehadiran() void
    }

    %% ==========================================
    %% 4. MODUL PMB & FACTORY PATTERN (SRP)
    %% ==========================================
    class PMBService {
        -PMBRepository repository
        -UserFactory userFactory
        -IEventPublisher eventPublisher
        +daftarPMB(CalonMahasiswa calon) String
        +validasiKelengkapanBerkas(CalonMahasiswa calon) bool
        +verifikasiBerkasPMB(String noDaftar, bool statusLulus) bool
        +generateNIM(int tahun, String kodeProdi, int noUrut) String
    }

    class PMBRepository {
        +simpanPendaftar(CalonMahasiswa calon) String
        +cariPendaftarByNoDaftar(String noDaftar) CalonMahasiswa
        +simpanMahasiswa(Mahasiswa mhs) bool
        +updateStatusSeleksi(String noDaftar, String status, String alasan) void
    }

    class UserFactory {
        +buatUser(String role, String nama, String email) User
        +buatMahasiswaDariCalon(CalonMahasiswa calon, String nim) Mahasiswa
    }

    %% ==========================================
    %% 5. MODUL KRS & STRATEGY PATTERN (OCP, SRP)
    %% ==========================================
    class KRSManager {
        -KRSValidator validator
        -AkademikRepository repository
        -IEventPublisher eventPublisher
        +submitKRS(Mahasiswa mhs, List~Course~ daftarCourse) ValidationResult
        +prosesApproval(Enrollment enrollment, bool disetujui, String alasan) void
    }

    class AkademikRepository {
        +getRiwayatNilaiLulus(String nim) List~Course~
        +getEnrollmentAktif(String nim, String semester) List~Enrollment~
        +simpanEnrollment(Mahasiswa mhs, List~Course~ daftarCourse, String status) List~Enrollment~
    }

    class ValidationResult {
        -bool valid
        -List~String~ daftarError
        +isValid() bool
        +tambahError(String pesan) void
        +getDaftarError() List~String~
    }

    class IValidationRule {
        <<interface>>
        +validate(Mahasiswa mhs, List~Course~ daftarCourse, List~Enrollment~ aktif) List~String~
    }

    class MaxSKSValidationRule {
        -int batasMaksSKS
        +validate(Mahasiswa mhs, List~Course~ daftarCourse, List~Enrollment~ aktif) List~String~
    }

    class PrerequisiteValidationRule {
        +validate(Mahasiswa mhs, List~Course~ daftarCourse, List~Enrollment~ aktif) List~String~
    }

    class ScheduleConflictRule {
        +validate(Mahasiswa mhs, List~Course~ daftarCourse, List~Enrollment~ aktif) List~String~
    }

    class DuplicateEnrollmentRule {
        +validate(Mahasiswa mhs, List~Course~ daftarCourse, List~Enrollment~ aktif) List~String~
    }

    class KRSValidator {
        -List~IValidationRule~ rules
        -AkademikRepository repository
        +tambahRule(IValidationRule rule) void
        +validasiKRS(Mahasiswa mhs, List~Course~ daftarCourse) ValidationResult
    }

    class TranscriptService {
        +hitungIPS(List~Enrollment~ enrollments) float
        +hitungIPK(List~Enrollment~ enrollments) float
        +generateTranskripPDF(Mahasiswa mhs, List~Enrollment~ enrollments) File
    }

    %% ==========================================
    %% 6. OBSERVER PATTERN & DIP NOTIFIKASI
    %% ==========================================
    class IEventSubscriber {
        <<interface>>
        +update(String eventType, String payload) void
    }

    class IEventPublisher {
        <<interface>>
        +subscribe(IEventSubscriber subscriber) void
        +unsubscribe(IEventSubscriber subscriber) void
        +notifySubscribers(String eventType, String payload) void
    }

    class EventBus {
        -List~IEventSubscriber~ subscribers
        +subscribe(IEventSubscriber subscriber) void
        +unsubscribe(IEventSubscriber subscriber) void
        +notifySubscribers(String eventType, String payload) void
    }

    class INotificationChannel {
        <<interface>>
        +kirim(String tujuan, String pesan) bool
    }

    class EmailNotificationChannel {
        -String smtpHost
        +kirim(String tujuan, String pesan) bool
    }

    class WhatsAppNotificationChannel {
        -String apiEndpoint
        +kirim(String tujuan, String pesan) bool
    }

    class NotificationService {
        -INotificationChannel channel
        +NotificationService(INotificationChannel channel)
        +update(String eventType, String payload) void
        +kirimNotifikasi(User penerima, String pesan) bool
    }

    class AuditLogSubscriber {
        +update(String eventType, String payload) void
    }

    %% ==========================================
    %% 7. RELASI ANTAR CLASS (Bebas Circular Dependency)
    %% ==========================================

    %% Inheritance (is-a)
    User <|-- Mahasiswa
    User <|-- Dosen
    User <|-- Admin
    User <|-- CalonMahasiswa

    %% Realization (Implements Interface - ISP, Strategy, Observer, DIP)
    IPengisiKRS <|.. Mahasiswa
    IPenyetujuKRS <|.. Dosen
    IPenilai <|.. Dosen
    IValidationRule <|.. MaxSKSValidationRule
    IValidationRule <|.. PrerequisiteValidationRule
    IValidationRule <|.. ScheduleConflictRule
    IValidationRule <|.. DuplicateEnrollmentRule
    IEventPublisher <|.. EventBus
    IEventSubscriber <|.. NotificationService
    IEventSubscriber <|.. AuditLogSubscriber
    INotificationChannel <|.. EmailNotificationChannel
    INotificationChannel <|.. WhatsAppNotificationChannel

    %% Composition (Kepemilikan Kuat)
    Enrollment "1" *-- "0..1" Grade : memiliki nilai
    Course "1" *-- "1..*" Schedule : memiliki jadwal
    Schedule "1" *-- "0..*" Attendance : mencatat presensi

    %% Aggregation (Kepemilikan Lemah)
    ProgramStudi "1" o-- "1..*" Dosen : menaungi
    ProgramStudi "1" o-- "0..*" Mahasiswa : mendaftarkan
    KRSValidator "1" o-- "1..*" IValidationRule : menerapkan
    EventBus "1" o-- "0..*" IEventSubscriber : mengelola subscriber

    %% Association (Domain)
    Mahasiswa "1" --> "0..*" Enrollment : mengambil
    Course "1" --> "0..*" Enrollment : diikuti melalui
    Course "0..*" --> "0..*" Course : prasyarat
    Mahasiswa "1" --> "0..*" Payment : memiliki tagihan
    Dosen "1" --> "0..*" Schedule : mengampu
    Dosen "1" --> "0..*" Mahasiswa : membimbing PA
    Mahasiswa "1" --> "0..*" Attendance : melakukan presensi
    NotificationService "1" --> "1" INotificationChannel : menggunakan via DIP

    %% Dependency (Services, Repositories, Factory, Observer)
    Admin ..> PMBService : memicu verifikasi
    PMBService ..> PMBRepository : menyimpan data
    PMBService ..> UserFactory : membuat Mahasiswa
    PMBService ..> IEventPublisher : mempublikasikan event
    UserFactory ..> CalonMahasiswa : membaca data
    UserFactory ..> User : membuat instance
    KRSManager ..> KRSValidator : mendelegasikan validasi
    KRSManager ..> AkademikRepository : menyimpan KRS
    KRSManager ..> IEventPublisher : mempublikasikan event
    KRSValidator ..> AkademikRepository : membaca riwayat nilai
    KRSValidator ..> ValidationResult : mengembalikan hasil
    TranscriptService ..> Enrollment : membaca
    TranscriptService ..> Grade : menghitung
